// ============================================================
// FraudGraph Schema — TigerGraph × HH Goa 2026
// ============================================================

USE GLOBAL
DROP GRAPH FraudGraph

// ── VERTICES ─────────────────────────────────────────────────

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  card1 STRING,
  card2 STRING,
  card3 STRING,
  card4 STRING,
  card5 STRING,
  card6 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX Transaction (
  PRIMARY_ID txn_id STRING,
  amount DOUBLE,
  product_cd STRING,
  addr1 STRING,
  addr2 STRING,
  p_email STRING,
  r_email STRING,
  channel STRING,
  risk_score DOUBLE,
  ts DATETIME,
  dist1 DOUBLE,
  dist2 DOUBLE,
  c_features STRING,
  d_features STRING,
  m_features STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_id STRING,
  device_type STRING,
  device_info STRING,
  os STRING,
  browser STRING,
  screen STRING,
  proxy_type STRING,
  id_15 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX BillingRegion (
  PRIMARY_ID region_code STRING,
  country_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,
  pattern STRING,
  first_fraud_txn_id STRING,
  txn_ids STRING,
  n_txns INT,
  exposure_usd DOUBLE,
  connected_card_ids STRING,
  actions_taken STRING,
  report_filed STRING,
  analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

CREATE VERTEX InvestigationCase (
  PRIMARY_ID case_id STRING,
  hhg_case_id STRING,
  status STRING,
  verdict STRING,
  fraud_probability DOUBLE,
  pattern STRING,
  exposure_usd DOUBLE,
  summary STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  answer_json STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

// ── EDGES ─────────────────────────────────────────────────────

CREATE UNDIRECTED EDGE OWNS (FROM Customer, TO Card)

CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"

CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_USED_IN"

CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)

CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion)

CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction, gap_seconds INT)

CREATE DIRECTED EDGE CASE_ON_CARD (FROM ClosedCase, TO Card)

CREATE DIRECTED EDGE CASE_INVOLVES_TXN (FROM ClosedCase, TO Transaction)

CREATE DIRECTED EDGE CASE_CONNECTED_CARD (FROM ClosedCase, TO Card)

CREATE DIRECTED EDGE INV_ON_CARD (FROM InvestigationCase, TO Card)

CREATE DIRECTED EDGE INV_INVOLVES_TXN (FROM InvestigationCase, TO Transaction)

CREATE DIRECTED EDGE SHARES_DEVICE (FROM Card, TO Card, via_device_id STRING, first_seen DATETIME)

// ── CREATE GRAPH ──────────────────────────────────────────────

CREATE GRAPH FraudGraph(*)
