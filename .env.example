# Copy this to .env and fill in your values
# TigerGraph connection (Savanna or local Docker)
TG_HOST=https://your-instance.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_GRAPHNAME=FraudGraph

# LLM - use your LM Studio local server OR OpenAI
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3-14b

# OR use OpenAI directly (comment out above, uncomment below)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Data paths
DATA_DIR=./HHGOA_IEEE
CASES_OUTPUT_DIR=./cases
